# Lombok settings for this module.
config.stopBubbling = true

# @RequiredArgsConstructor generates the constructor Spring injects through, but
# Lombok does NOT carry field annotations onto the generated parameters unless
# they are listed here. Without this, a @Qualifier on a final field is silently
# dropped and startup fails with "required a single bean, but N were found" —
# which is exactly what happened to DashboardService's executor, since Spring's
# WebSocket config also publishes three java.util.concurrent.Executor beans.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
