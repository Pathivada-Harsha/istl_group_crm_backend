<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot Parent -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <!-- Project Info -->
    <groupId>com.istlgroup</groupId>
    <artifactId>istl_group_crm_backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>istl_group_crm_backend</name>
    <description>ISTL Group CRM Backend</description>

    <!-- Java Version -->
    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.42</lombok.version>
    </properties>

    <!-- Dependencies -->
    <dependencies>

        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- LOGIN ACTIVITY MODULE: required by AuditedAspect (@Audited) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<!-- Spring Security (REQUIRED for CORS + credentials) -->
		<dependency>
		    <groupId>org.springframework.boot</groupId>
		    <artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
		    <groupId>org.apache.poi</groupId>
		    <artifactId>poi-ooxml</artifactId>
		    <version>5.2.5</version>
		</dependency>
		<!-- WebClient (WebFlux) -->
		<dependency>
		    <groupId>org.springframework.boot</groupId>
		    <artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MySQL Connector -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        
        
        <dependency>
		    <groupId>org.mindrot</groupId>
		    <artifactId>jbcrypt</artifactId>
		    <version>0.4</version>
		</dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- DevTools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

		<!-- WebSocket / STOMP for real-time notifications -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        
        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
		<dependency>
		    <groupId>com.itextpdf</groupId>
		    <artifactId>itext7-core</artifactId>
		    <version>7.2.5</version>
		    <type>pom</type>
		</dependency>

		<!-- Apache PDFBox 3.x — text extraction for Tender NIT/PDF auto-fill -->
		<dependency>
		    <groupId>org.apache.pdfbox</groupId>
		    <artifactId>pdfbox</artifactId>
		    <version>3.0.3</version>
		</dependency>
		    </dependencies>

    <!-- Build Configuration -->
    <build>
        <plugins>

            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Spring Boot Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                Resolves each dependency's jar path into a property named
                "<groupId>:<artifactId>:jar", so surefire below can point
                -javaagent at the Mockito jar without hardcoding a version or a
                path into ~/.m2. Binds to the initialize phase by default.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-agent-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Load Mockito as a JVM agent instead of letting it attach itself.

                Mockito's inline mock maker needs an instrumentation agent. With no
                configuration it SELF-ATTACHES at runtime, and prints:

                  "Mockito is currently self-attaching to enable the inline-mock-maker.
                   This will no longer work in future releases of the JDK."

                Self-attach is already disabled by default on modern JDKs, so Mockito
                falls back to spawning an EXTERNAL process to do the attach. When that
                spawn fails — on this machine, under memory/paging pressure — every
                mock-based test dies at once with:

                  MockitoInitializationException: Could not initialize inline Byte Buddy
                  mock maker ... Could not self-attach to current VM using external process

                which reads like the test suite is broken when nothing is wrong with it.
                Passing the agent up front removes the attach step entirely: no spawn, no
                dependence on free memory, and no deprecation warning.

                -Xshare:off avoids a CDS-vs-instrumentation warning on some JDK builds.

                NOTE: passing -DargLine=... on the command line REPLACES this value and
                takes the agent with it. Use -Dsurefire.argLine or add to MAVEN_OPTS
                instead if you need to cap heap for a single run.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        The heap caps are not tuning, they are a fix. An uncapped forked
                        test JVM defaults its max heap to 1/4 of physical RAM and commits
                        it up front; on this machine that commit fails against the Windows
                        paging file and surefire reports only:

                          "The forked VM terminated without properly saying goodbye"
                          os::commit_memory(... 547356672 ...) failed;
                          error='The paging file is too small for this operation to complete'

                        which looks like a crashed test run rather than a machine that
                        cannot hand out the memory. The whole 325-test suite fits well
                        inside these numbers, so capping them makes "mvnw clean install"
                        work without every developer having to remember MAVEN_OPTS.
                    -->
                    <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off -Xmx768m -XX:MaxMetaspaceSize=320m</argLine>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>